{
  "info": {
    "_postman_id": "e50fc5de-7ab4-40ed-80f5-d4f0e5d0a143",
    "name": "Secure Student Management API",
    "description": "Authentication and student CRUD requests. Run in order; the student account setup enables the STUDENT list request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login as TEACHER",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{teacherUsername}}\",\n  \"password\": \"{{teacherPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Teacher login succeeds', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) { pm.environment.set('teacherToken', pm.response.json().accessToken); }"
          ]
        }
      }]
    },
    {
      "name": "Login as ADMIN",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Admin login succeeds', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) { pm.environment.set('adminToken', pm.response.json().accessToken); }"
          ]
        }
      }]
    },
    {
      "name": "Setup STUDENT account",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now();",
              "pm.environment.set('studentUsername', 'postman-student-' + suffix);",
              "pm.environment.set('studentEmail', 'postman-student-' + suffix + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Student account created', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{studentUsername}}\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Login as STUDENT",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{studentUsername}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Student login succeeds', function () { pm.response.to.have.status(200); });",
            "if (pm.response.code === 200) { pm.environment.set('studentToken', pm.response.json().accessToken); }"
          ]
        }
      }]
    },
    {
      "name": "Create student as TEACHER",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registrationNumber\": \"UDSM/2026/0142\",\n  \"fullName\": \"Neema Mushi\",\n  \"email\": \"neema.mushi@gmail.com\",\n  \"phone\": \"+255712345678\",\n  \"gender\": \"FEMALE\",\n  \"dateOfBirth\": \"2003-05-14\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/students"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Student created', function () { pm.response.to.have.status(201); });",
            "if (pm.response.code === 201) { pm.environment.set('studentId', pm.response.json().id); }"
          ]
        }
      }]
    },
    {
      "name": "Duplicate student registration number",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registrationNumber\": \"UDSM/2026/0142\",\n  \"fullName\": \"Another Student\",\n  \"email\": \"another.student@gmail.com\",\n  \"phone\": \"0712345678\",\n  \"gender\": \"OTHER\",\n  \"dateOfBirth\": \"2004-08-22\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/students"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Duplicate registration number is rejected', function () { pm.response.to.have.status(409); });"
          ]
        }
      }]
    },
    {
      "name": "List students as STUDENT",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
        "url": "{{baseUrl}}/api/students"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": ["pm.test('Student can list students', function () { pm.response.to.have.status(200); });"]
        }
      }]
    },
    {
      "name": "Get student by id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": ["pm.test('Student is found by id', function () { pm.response.to.have.status(200); });"]
        }
      }]
    },
    {
      "name": "Update student as TEACHER",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registrationNumber\": \"UDSM/2026/0142\",\n  \"fullName\": \"Neema Mushi Selemani\",\n  \"email\": \"neema.mushi@gmail.com\",\n  \"phone\": \"+255713456789\",\n  \"gender\": \"FEMALE\",\n  \"dateOfBirth\": \"2003-05-14\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": ["pm.test('Teacher can update student', function () { pm.response.to.have.status(200); });"]
        }
      }]
    },
    {
      "name": "Create student as STUDENT (forbidden)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{studentToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registrationNumber\": \"UDSM/2026/0143\",\n  \"fullName\": \"Student Not Allowed\",\n  \"email\": \"student.not.allowed@gmail.com\",\n  \"phone\": \"0712345678\",\n  \"gender\": \"OTHER\",\n  \"dateOfBirth\": \"2004-08-22\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/students"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": ["pm.test('Student cannot create students', function () { pm.response.to.have.status(403); });"]
        }
      }]
    },
    {
      "name": "Delete student as TEACHER (forbidden)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": ["pm.test('Teacher cannot delete students', function () { pm.response.to.have.status(403); });"]
        }
      }]
    },
    {
      "name": "Delete student as ADMIN",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": ["pm.test('Admin can delete student', function () { pm.response.to.have.status(204); });"]
        }
      }]
    },
    {
      "name": "Get deleted student (not found)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Deleted student is not found', function () {",
            "  pm.response.to.have.status(404);",
            "  pm.expect(pm.response.json().message).to.include('Student not found');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "Invalid student data",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registrationNumber\": \"UDSM/2026/0144\",\n  \"fullName\": \" \",\n  \"email\": \"not-an-email\",\n  \"phone\": \"+255712345678\",\n  \"gender\": \"FEMALE\",\n  \"dateOfBirth\": \"2999-05-14\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/students"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Invalid student data has field errors', function () {",
            "  pm.response.to.have.status(400);",
            "  const errors = pm.response.json().fieldErrors;",
            "  pm.expect(errors).to.have.property('email');",
            "  pm.expect(errors).to.have.property('fullName');",
            "  pm.expect(errors).to.have.property('dateOfBirth');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "List students without a token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/students"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": ["pm.test('Missing token is unauthorized', function () { pm.response.to.have.status(401); });"]
        }
      }]
    }
  ]
}
